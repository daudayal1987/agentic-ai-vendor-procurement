# Application
APP_NAME=enterprise-document-intelligence
APP_ENV=local
LOG_LEVEL=INFO

# Execution
EXECUTION_MODE=local

# Database
DATABASE_BACKEND=postgres
DATABASE_URL=

# Object Storage
STORAGE_BACKEND=local

# Queue
QUEUE_BACKEND=local

# Notification
NOTIFICATION_BACKEND=local

# Vector Store
VECTOR_BACKEND=local

# LLM
MODEL_BACKEND=ollama

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30